# Public canonical website origin; verify this with the site owner before deployment.
NEXT_PUBLIC_SITE_URL=https://businessanalysisschool.com

# Configure this server-only variable in the deployment environment.
# If unset, the API temporarily uses the legacy public GHL webhook.
GHL_WEBHOOK_URL=

# Public, non-secret embed URL from the approved video host.
NEXT_PUBLIC_MASTERCLASS_EMBED_URL=

# Public booking/payment URLs for the paid career consultations.
NEXT_PUBLIC_CAREER_CONSULTATION_30_URL=
NEXT_PUBLIC_CAREER_CONSULTATION_60_URL=
